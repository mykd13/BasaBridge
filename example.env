# Copy to .env.local and fill in. Never commit real values.

# Postgres connection string (Vercel Marketplace Postgres, e.g. Neon)
DATABASE_URL=

# Session signing secret (generate with: openssl rand -base64 32)
AUTH_SECRET=

# AI Gateway key for story generation and teacher notes
AI_GATEWAY_API_KEY=

# Model names as AI Gateway strings, for example google/<model>. See docs/adr/0002-story-model.md.
# Stories are generated by Gemini; the verifier is a different, larger Gemini model.
STORY_MODEL=
VERIFIER_MODEL=
NOTES_MODEL=

# Speech provider (chosen in BB-22). Leave blank until then.
SPEECH_PROVIDER=
SPEECH_API_KEY=

# Observability, rate limits and AI cost budgets (BB-39). See docs/observability.md.
# Vercel sends this as a bearer token to /api/cron/alerts. At least 16 characters.
CRON_SECRET=
# Bearer token for /api/ops/cost-report. At least 16 characters.
OPS_TOKEN=
# Optional. Alerts are posted here as JSON ({ text, alerts }). Leave blank to log only.
ALERT_WEBHOOK_URL=
# Daily caps in US dollars. Past either cap, new stories come from the story bank.
AI_DAILY_BUDGET_USD=10
AI_LEARNER_DAILY_BUDGET_USD=0.5
# Share of the daily budget that raises the high cost alert (0..1).
AI_BUDGET_ALERT_SHARE=0.8
# Speech price per minute of audio, used to record speech cost. Blank records no cost.
SPEECH_USD_PER_MINUTE=
# Optional overrides as <limit>/<seconds>, for example RATE_LIMIT_STORY_PER_LEARNER=20/3600.
# RATE_LIMIT_STORY_PER_LEARNER=
# RATE_LIMIT_SIGN_IN_PER_IP=

# One-click unsubscribe signing key for optional emails (BB-76). At least 32 characters.
UNSUBSCRIBE_SECRET=

# Use SPEECH_PROVIDER=fake for local work without a provider. Optional timeout in ms (default 20000).
SPEECH_TIMEOUT_MS=

# Key for encrypting retained audio, 32 bytes base64 (generate with: openssl rand -base64 32)
AUDIO_ENCRYPTION_KEY=
