# Copy to .env.local and fill in. Never commit real values.

# Postgres connection string (Vercel Marketplace Postgres, e.g. Neon)
DATABASE_URL=

# Session signing secret (generate with: openssl rand -base64 32)
AUTH_SECRET=

# AI Gateway key for story generation and teacher notes
AI_GATEWAY_API_KEY=

# Model names as AI Gateway strings, for example google/<model>. See docs/adr/0002-story-model.md.
# Stories are generated by Gemini; the verifier is a different, larger Gemini model.
STORY_MODEL=
VERIFIER_MODEL=
NOTES_MODEL=

# Speech provider (chosen in BB-22). Leave blank until then.
SPEECH_PROVIDER=
SPEECH_API_KEY=

# Email through Resend (docs/adr/0006-email-provider.md). Leave all three blank locally:
# emails are then captured in memory and not sent. Production refuses to send without them.
RESEND_API_KEY=
# Webhook signing secret from Resend, starting with whsec_. Used by /api/email/webhook.
RESEND_WEBHOOK_SECRET=
# Sender, for example: BasaBridge <hello@your-domain>
EMAIL_FROM=
# Key for hashing bounced addresses (generate with: openssl rand -base64 32). Set once per
# database and never change it. Required in production; a fixed dev key is used locally.
EMAIL_HASH_SECRET=

# Use SPEECH_PROVIDER=fake for local work without a provider. Optional timeout in ms (default 20000).
SPEECH_TIMEOUT_MS=

# Key for encrypting retained audio, 32 bytes base64 (generate with: openssl rand -base64 32)
AUDIO_ENCRYPTION_KEY=
